# ==============================================================================
# ORVA STORE — Environment Variables Example
# Copy this to .env.local for local development.
# In Vercel, add each of these keys in Project Settings > Environment Variables.
# ==============================================================================

# ── Supabase Configuration ───────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
SUPABASE_KEY=your_supabase_publishable_or_anon_key
# Server-only. Never put this in browser JS, Git commits, or public ZIP packages.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_SCHEMA=public
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# ── Staging PDO (local / Staging only — never enable on Production) ───────────
# When STAGING_USE_PDO=true and APP_ENV=local|staging, PHP order APIs use
# lib/staging-db.php instead of PostgREST. Default local mode is mock (no DB).
STAGING_USE_PDO=false
STAGING_PDO_MODE=auto
STAGING_PDO_ALLOW_LIVE=false
# STAGING_PDO_DSN=pgsql:host=127.0.0.1;port=5432;dbname=orva_staging_local;sslmode=disable
# STAGING_PDO_USER=staging_login
# STAGING_PDO_PASSWORD=
# STAGING_PDO_TIMEOUT=5
# STAGING_PDO_SSLMODE=require
# Force PostgREST mock in Node/tests (never hits hosted Supabase):
# ORVA_TEST_MOCK_SUPABASE=true

# ── Admin Dashboard Security ──────────────────────────────────────────────────
# Required on Vercel Preview/Production for /api/auth login (Node handlers).
# Hostinger uses the same keys via env or outside-webroot secure-config.php.
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_API_TOKEN=your_secure_admin_api_token

# ── Telegram Notifications ────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ── Redex Ecotrack Delivery Integration ───────────────────────────────────────
ECOTRACK_API_TOKEN=your_ecotrack_api_token

# ── Vercel Web Analytics ──────────────────────────────────────────────────────
VERCEL_TOKEN=your_vercel_token
VERCEL_API_TOKEN=your_vercel_token
VERCEL_PROJECT_ID=your_vercel_project_id
VERCEL_TEAM_ID=your_vercel_team_id

# ── Google Sheets API (Optional fallback) ─────────────────────────────────────
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# ── Meta Pixel & Conversions API (CAPI) ──────────────────────────────────────
META_PIXEL_ID=2340414976777036
META_ACCESS_TOKEN=your_meta_system_user_access_token_here
META_TEST_EVENT_CODE=


# ── Administrative Settings Encryption Key (Phase 8D.1.1: Independent 256-bit key) ──
ADMIN_SETTINGS_ENCRYPTION_KEY=YOUR_BASE64_ENCODED_32_BYTE_ENCRYPTION_KEY

# ── CodFlow Integration Bridge (Phase 0) ─────────────────────────────────────
# Base origin of the CodFlow cod-server. Leave blank until CodFlow is deployed.
# Production must be HTTPS. HTTP is only accepted for localhost when
# CODFLOW_ALLOW_INSECURE_LOCAL=true (wrangler dev).
CODFLOW_API_URL=
# Dedicated CodFlow service user key (role: staff, least-privilege scopes).
# SERVER-SIDE ONLY. Never prefix this with NEXT_PUBLIC_ and never commit a value.
CODFLOW_API_KEY=
# Upstream timeout in milliseconds. Clamped to 1000-60000.
CODFLOW_TIMEOUT_MS=20000
# Runtime feature flags. Rollback = set a domain to "off" and purge LiteSpeed
# cache. No dashboard rebuild is required.
CODFLOW_FLAGS=orders:off,products:off,customers:off,delivery:off,store:off,auth:bridge
# Allow http://localhost / http://127.0.0.1 only. Never enable in production.
CODFLOW_ALLOW_INSECURE_LOCAL=false
# Optional: absolute bridge URL for local Next.js dev (e.g. http://localhost:8080/api/codflow).
# Leave unset in production so the static dashboard uses the same-origin path.
# NEXT_PUBLIC_CODFLOW_BRIDGE_PATH=/api/codflow
