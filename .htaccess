# ==============================================================================
# ORVA STORE — Hostinger LiteSpeed Configuration (.htaccess)
# Website: orva-store.com
# Optimized for: LiteSpeed Web Server + PHP 8.3
# ==============================================================================

RewriteEngine On
RewriteBase /

# ── 1. Force HTTPS ─────────────────────────────────────────────────────────────
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── 2. Clean URLs & A/B Testing Routing ─────────────────────────────────────────
RewriteRule ^pack1/?$ pack1.html [L]
RewriteRule ^pack2/?$ pack2.html [L]
RewriteRule ^yamaha/?$ yamaha-archive.html [L]

# Dynamic Published Product Pages & Isolated Preview (Protected)
# Protect /preview/* and /data/preview/* from public discovery (Admin Session or Localhost Only)
RewriteCond %{HTTP_COOKIE} !orva_admin_session
RewriteCond %{REMOTE_ADDR} !^127\.0\.0\.1$
RewriteCond %{REMOTE_ADDR} !^::1$
RewriteRule ^(preview|data/preview)(/.*)?$ - [F,L,NC]

RewriteRule ^products/([a-zA-Z0-9_-]+)/?$ products/$1.html [L]
RewriteRule ^preview/(.*)$ data/preview/$1 [L]

# Next.js Static Asset Chunks (served from admin directory)
RewriteRule ^_next/(.*)$ admin/_next/$1 [L]

# Legacy Dashboard Redirect: Route /admin and /admin.html directly to Modern Dashboard
RewriteRule ^admin(?:\.html)?/?$ /dashboard/ecommerce [R=301,L]

# Default / Modern: Serve Modern Next.js Dashboard SPA
# Prevent recursive rewrite loops on existing files
RewriteCond %{DOCUMENT_ROOT}/admin/$1 -f
RewriteRule ^admin/(.*)$ admin/$1 [L]

# Map /dashboard/* or /admin/dashboard/* to admin/dashboard/*/index.html without loop
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(\.(html|txt|js|css|png|jpg|svg|ico|json))$
RewriteRule ^(?:admin/)?dashboard/(.+?)/?$ admin/dashboard/$1/index.html [L,QSA]

RewriteRule ^admin/?$ admin/index.html [L]
RewriteRule ^dashboard/?$ admin/dashboard/default/index.html [L]
ErrorDocument 404 /admin/404.html

# ── 3. Transparent API Routing to PHP 8.3 Backend ─────────────────────────────
RewriteRule ^api/send-order/?$ api/send-order.php [L,QSA]
RewriteRule ^api/auth/?$ api/auth.php [L,QSA]
RewriteRule ^api/delivery/?$ api/delivery.php [L,QSA]
RewriteRule ^api/publish-page/?$ api/publish-page.php [L,QSA]
RewriteRule ^api/admin-settings/?$ api/admin-settings.php [L,QSA]
RewriteRule ^api/analytics/?$ api/analytics.php [L,QSA]

# ── 4. MIME Types ─────────────────────────────────────────────────────────────
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType text/css .css
    AddType application/javascript .js
    AddType application/json .json
</IfModule>

# ── 5. LiteSpeed Browser Caching ──────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType text/html "access plus 1 hour"
</IfModule>

# ── 5.1. Never Cache Admin Dashboard Assets (Real-time updates) ──────────────
<FilesMatch "^(admin\.html|admin\.js|admin\.css)$">
    FileETag None
    <IfModule mod_headers.c>
        Header unset ETag
        Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
        Header set X-LiteSpeed-Cache-Control "no-cache"
    </IfModule>
</FilesMatch>

# ── 6. Gzip / Deflate Compression ─────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
</IfModule>

# ── 7. Security Hardening ─────────────────────────────────────────────────────
Options -Indexes

# Block hidden files (.git, .env, etc.)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Local admin integration settings and internal data/backup directories are server-side only.
RewriteRule ^data/private(?:/|$) - [F,L,NC]
RewriteRule ^backups(?:/|$) - [F,L,NC]

# Block direct access to data directory (except internal /data/preview/ when permitted)
RewriteCond %{REQUEST_URI} !^/data/preview/
RewriteRule ^data(/.*)?$ - [F,L,NC]

# Block access to source code, lock, and sensitive metadata files
<FilesMatch "\.enc$">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "\.(xlsx|xls|csv|json|env|log|md|ps1|sh|sql|yml|yaml|lock|enc|bak|tmp|swp|ini|cfg)$">
    Order allow,deny
    Deny from all
</FilesMatch>
