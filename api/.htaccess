# ==============================================================================
# ORVA STORE — API Directory Security
# Website: orva-store.com
# ==============================================================================

# Deny direct access to config and private files
<FilesMatch "^(config\.php|\.htaccess|\.env.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes
